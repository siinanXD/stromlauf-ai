{
  "$defs": {
    "Action": {
      "additionalProperties": false,
      "description": "Was ein Schritt tut: Ausgang setzen oder ruecksetzen.",
      "properties": {
        "io": {
          "description": "address oder symbol eines IOPoint",
          "title": "Io",
          "type": "string"
        },
        "state": {
          "enum": [
            0,
            1
          ],
          "title": "State",
          "type": "integer"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "io",
        "state"
      ],
      "title": "Action",
      "type": "object"
    },
    "Condition": {
      "additionalProperties": false,
      "description": "Bedingung einer Transition; alle Bedingungen einer Transition sind UND-verknuepft.",
      "properties": {
        "io": {
          "description": "address oder symbol eines IOPoint",
          "title": "Io",
          "type": "string"
        },
        "state": {
          "enum": [
            0,
            1
          ],
          "title": "State",
          "type": "integer"
        },
        "edge": {
          "anyOf": [
            {
              "enum": [
                "rising",
                "falling"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Flanke statt Pegel, sonst null",
          "title": "Edge"
        }
      },
      "required": [
        "io",
        "state"
      ],
      "title": "Condition",
      "type": "object"
    },
    "IOPoint": {
      "additionalProperties": false,
      "description": "Ein Ein- oder Ausgang der SPS mit Sensor bzw. Aktor dahinter.",
      "properties": {
        "source": {
          "$ref": "#/$defs/Source"
        },
        "confidence": {
          "description": "Sicherheit des Modells 0..1",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "assumption": {
          "default": false,
          "description": "true = nicht belegt, sondern angenommen",
          "title": "Assumption",
          "type": "boolean"
        },
        "address": {
          "description": "Normalisierte SPS-Adresse, z. B. E0.0, A4.1",
          "title": "Address",
          "type": "string"
        },
        "symbol": {
          "default": "",
          "description": "Symbolname aus der Symboltabelle, z. B. LS_Einlauf",
          "title": "Symbol",
          "type": "string"
        },
        "direction": {
          "enum": [
            "DI",
            "DO",
            "AI",
            "AO"
          ],
          "title": "Direction",
          "type": "string"
        },
        "kind": {
          "description": "sensor = Sensor/Geber, actuator = Aktor, operator = Bedienelement, safety = Sicherheitskreis",
          "enum": [
            "sensor",
            "actuator",
            "operator",
            "safety",
            "other"
          ],
          "title": "Kind",
          "type": "string"
        },
        "contact": {
          "anyOf": [
            {
              "enum": [
                "NC",
                "NO"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Oeffner (NC) oder Schliesser (NO), sonst null",
          "title": "Contact"
        },
        "tag": {
          "default": "",
          "description": "Betriebsmittelkennzeichen, z. B. -B1",
          "title": "Tag",
          "type": "string"
        },
        "location": {
          "default": "",
          "description": "Einbauort, z. B. +FE1 Einlauf",
          "title": "Location",
          "type": "string"
        },
        "description": {
          "default": "",
          "description": "Klartext, z. B. 'Lichtschranke Einlauf, 1 = Teil erkannt'",
          "title": "Description",
          "type": "string"
        },
        "active_state": {
          "default": 1,
          "description": "Signalpegel, bei dem der Punkt als 'ausgeloest' gilt",
          "enum": [
            0,
            1
          ],
          "title": "Active State",
          "type": "integer"
        }
      },
      "required": [
        "source",
        "confidence",
        "address",
        "direction",
        "kind"
      ],
      "title": "IOPoint",
      "type": "object"
    },
    "Layout": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "default": "",
          "description": "Beschriftung, z. B. 'Foerderband FB-01, Draufsicht'",
          "title": "Title",
          "type": "string"
        },
        "elements": {
          "items": {
            "$ref": "#/$defs/LayoutElement"
          },
          "title": "Elements",
          "type": "array"
        }
      },
      "title": "Layout",
      "type": "object"
    },
    "LayoutElement": {
      "additionalProperties": false,
      "description": "Lage eines IOPoint in der Draufsicht, relative Koordinaten 0..1.",
      "properties": {
        "io": {
          "description": "address oder symbol eines IOPoint",
          "title": "Io",
          "type": "string"
        },
        "x": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Y",
          "type": "number"
        },
        "shape": {
          "default": "circle",
          "enum": [
            "circle",
            "rect",
            "arrow"
          ],
          "title": "Shape",
          "type": "string"
        },
        "assumption": {
          "default": true,
          "description": "Lage aus der Doku belegt (false) oder geschaetzt (true)",
          "title": "Assumption",
          "type": "boolean"
        }
      },
      "required": [
        "io",
        "x",
        "y"
      ],
      "title": "LayoutElement",
      "type": "object"
    },
    "Meta": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "prompt_version": {
          "description": "Version der Extraktions-Prompts; Teil des Cache-Schluessels",
          "title": "Prompt Version",
          "type": "string"
        },
        "cache_key": {
          "description": "SHA-256 ueber Dokument(e) + prompt_version",
          "title": "Cache Key",
          "type": "string"
        },
        "document_sha256": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Dateiname -> SHA-256",
          "title": "Document Sha256",
          "type": "object"
        },
        "trace_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Langfuse-Trace-ID, null ohne Langfuse",
          "title": "Trace Id"
        },
        "models": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Rolle -> Modell-ID, z. B. {'small': ..., 'strong': ...}",
          "title": "Models",
          "type": "object"
        },
        "phases": {
          "items": {
            "$ref": "#/$defs/Phase"
          },
          "title": "Phases",
          "type": "array"
        },
        "total": {
          "$ref": "#/$defs/Usage"
        },
        "extracted_at": {
          "format": "date-time",
          "title": "Extracted At",
          "type": "string"
        },
        "cached": {
          "default": false,
          "description": "true = aus dem Cache gelesen, keine Kosten",
          "title": "Cached",
          "type": "boolean"
        }
      },
      "required": [
        "prompt_version",
        "cache_key",
        "document_sha256",
        "models",
        "extracted_at"
      ],
      "title": "Meta",
      "type": "object"
    },
    "Phase": {
      "additionalProperties": false,
      "description": "Ein Extraktionsschritt (Span) mit Modell und Verbrauch.",
      "properties": {
        "name": {
          "enum": [
            "io_points",
            "sensors_actuators",
            "steps",
            "layout"
          ],
          "title": "Name",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        },
        "cached": {
          "default": false,
          "title": "Cached",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "model",
        "usage"
      ],
      "title": "Phase",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "description": "Belegstelle: woher ein Feld stammt. Zitat hoechstens 15 Woerter.",
      "properties": {
        "file": {
          "description": "Dateiname des Dokuments",
          "title": "File",
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "PDF-Seite (1-basiert), sonst null",
          "title": "Page"
        },
        "chunk": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Abschnitt, z. B. 'FB 10 / NW 3' oder 'Kap. 3'",
          "title": "Chunk"
        },
        "quote": {
          "description": "Woertliches Zitat, hoechstens 15 Woerter",
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "file",
        "quote"
      ],
      "title": "Source",
      "type": "object"
    },
    "Step": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/Source"
        },
        "confidence": {
          "description": "Sicherheit des Modells 0..1",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "assumption": {
          "default": false,
          "description": "true = nicht belegt, sondern angenommen",
          "title": "Assumption",
          "type": "boolean"
        },
        "id": {
          "description": "Eindeutig, z. B. S0, S1",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "description": "Kurzname, z. B. 'Grundstellung', 'Band vorwaerts'",
          "title": "Name",
          "type": "string"
        },
        "initial": {
          "default": false,
          "description": "Anfangsschritt (genau einer)",
          "title": "Initial",
          "type": "boolean"
        },
        "actions": {
          "items": {
            "$ref": "#/$defs/Action"
          },
          "title": "Actions",
          "type": "array"
        },
        "transitions": {
          "items": {
            "$ref": "#/$defs/Transition"
          },
          "title": "Transitions",
          "type": "array"
        }
      },
      "required": [
        "source",
        "confidence",
        "id",
        "name"
      ],
      "title": "Step",
      "type": "object"
    },
    "Transition": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/Source"
        },
        "confidence": {
          "description": "Sicherheit des Modells 0..1",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "assumption": {
          "default": false,
          "description": "true = nicht belegt, sondern angenommen",
          "title": "Assumption",
          "type": "boolean"
        },
        "target": {
          "description": "id des Folgeschritts",
          "title": "Target",
          "type": "string"
        },
        "conditions": {
          "description": "leer = sofort/Zeit",
          "items": {
            "$ref": "#/$defs/Condition"
          },
          "title": "Conditions",
          "type": "array"
        },
        "timer_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Wartezeit in Sekunden, wenn zeitgesteuert",
          "title": "Timer S"
        },
        "expression": {
          "default": "",
          "description": "Bedingung im Klartext, z. B. 'LS_Auslauf UND NICHT Stop'",
          "title": "Expression",
          "type": "string"
        }
      },
      "required": [
        "source",
        "confidence",
        "target"
      ],
      "title": "Transition",
      "type": "object"
    },
    "Usage": {
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "default": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "cost_usd": {
          "default": 0.0,
          "title": "Cost Usd",
          "type": "number"
        },
        "latency_ms": {
          "default": 0,
          "title": "Latency Ms",
          "type": "integer"
        }
      },
      "title": "Usage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Wurzel: Ablauf einer Maschine fuer die Animation.",
  "properties": {
    "machine": {
      "description": "Name der Maschine, z. B. 'Foerderband FB-01'",
      "title": "Machine",
      "type": "string"
    },
    "summary": {
      "default": "",
      "description": "Ablauf in zwei bis drei Saetzen",
      "title": "Summary",
      "type": "string"
    },
    "io_points": {
      "items": {
        "$ref": "#/$defs/IOPoint"
      },
      "title": "Io Points",
      "type": "array"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/Step"
      },
      "title": "Steps",
      "type": "array"
    },
    "layout": {
      "$ref": "#/$defs/Layout"
    },
    "open_questions": {
      "description": "Was die Doku nicht hergibt",
      "items": {
        "type": "string"
      },
      "title": "Open Questions",
      "type": "array"
    },
    "meta": {
      "$ref": "#/$defs/Meta"
    }
  },
  "required": [
    "machine",
    "io_points",
    "steps",
    "meta"
  ],
  "title": "MachineFlow",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stromlauf.local/schemas/machine_flow.json"
}
