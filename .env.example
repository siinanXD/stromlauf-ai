# Kopieren nach .env und ausfuellen. .env wird NICHT committet.

# --- LLM ---
ANTHROPIC_API_KEY=sk-ant-...
CHAT_MODEL=claude-sonnet-5
VISION_MODEL=claude-opus-5-5

# --- Datenbank (Postgres + pgvector aus docker-compose.yml) ---
DATABASE_URL=postgresql+psycopg://stromlauf:stromlauf@localhost:5433/stromlauf

# --- Embeddings (lokal, kein API-Key noetig) ---
# Modellwechsel => EMBEDDING_DIM anpassen und Dokumente neu indexieren.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# --- Ingestion ---
# OCR nur fuer gescannte PDFs noetig (EPLAN-Exporte enthalten echten Text).
OCR_ENABLED=false
# Laengste Bildkante in Pixeln fuer die Vision-Analyse von Schaltplanseiten.
VISION_MAX_EDGE=2400

# --- Tracing (optional, Langfuse Cloud EU oder selbst gehostet) ---
# Keys setzen und "pip install -e .[tracing]" im Backend: jeder Chat wird ein Trace mit Tokens/Kosten.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com

# --- Frontend ---
CORS_ORIGINS=http://localhost:3100
NEXT_PUBLIC_API_URL=http://localhost:8010
