# Kopieren nach .env und ausfuellen. .env wird NICHT committet.

# --- LLM ---
ANTHROPIC_API_KEY=sk-ant-...
CHAT_MODEL=claude-opus-5
VISION_MODEL=claude-opus-5

# --- Datenbank (Postgres + pgvector aus docker-compose.yml) ---
DATABASE_URL=postgresql+psycopg://stromlauf:stromlauf@localhost:5433/stromlauf

# --- Embeddings (lokal, kein API-Key noetig) ---
# Modellwechsel => EMBEDDING_DIM anpassen und Dokumente neu indexieren.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# --- Ingestion ---
# OCR nur fuer gescannte PDFs noetig (EPLAN-Exporte enthalten echten Text).
OCR_ENABLED=false
# Laengste Bildkante in Pixeln fuer die Vision-Analyse von Schaltplanseiten.
VISION_MAX_EDGE=2400

# --- Ablauf-Visualisierung (extract-flow) ---
# Kleines Modell fuer I/O-Liste und Sensor/Aktor (parallel), starkes nur fuer die Schrittkette.
FLOW_MODEL_SMALL=claude-haiku-4-5
FLOW_MODEL_STRONG=claude-opus-5
FLOW_EFFORT=medium
# Langfuse (optional, pip install -e "backend[trace]"): ohne Schluessel kein Trace, Extraktion laeuft trotzdem.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Zugriff ---
# Gemeinsamer Schluessel fuer alle /api-Routen (leer = offen, nur lokal). Frontend, Skripte und
# MCP-Server schicken ihn als X-API-Key; Bild-URLs als ?api_key=. Erzeugen: python -c "import secrets;print(secrets.token_urlsafe(32))"
API_KEY=
NEXT_PUBLIC_API_KEY=
STROMLAUF_API_KEY=

# --- Frontend ---
CORS_ORIGINS=http://localhost:3100
NEXT_PUBLIC_API_URL=http://localhost:8010
