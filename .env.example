# Kopieren nach .env und ausfuellen. .env wird NICHT committet.

# --- LLM ---
# Zwei Provider: Anthropic (Standard) und OpenAI. Modellnamen wahlweise mit Praefix ("openai:gpt-5-mini",
# "anthropic:claude-sonnet-5") oder ohne (claude-* = Anthropic, gpt-*/o3* = OpenAI). Ein Modell braucht den
# Schluessel seines Providers; die Ablauf-Extraktion (FLOW_MODEL_*) bleibt Anthropic. Preise: app/flow/pricing.py.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=
# Standard laut docs/product/cost-model.md; claude-opus-5 kostet das 2,5-fache und bleibt der Schrittkette vorbehalten.
CHAT_MODEL=claude-sonnet-5
VISION_MODEL=claude-sonnet-5
# Leitplanken je Chat-Antwort (Issue #48): Werkzeugaufrufe, Zeitlimit in Sekunden, Nachrichten im Modellkontext (0 = alle).
CHAT_MAX_TOOL_CALLS=12
CHAT_TIMEOUT_S=60
CHAT_HISTORY_MESSAGES=20

# --- Datenbank (Postgres + pgvector aus docker-compose.yml) ---
DATABASE_URL=postgresql+psycopg://stromlauf:stromlauf@localhost:5433/stromlauf

# --- Embeddings ---
# local: sentence-transformers im Prozess (bge-m3, ca. 2 GB, braucht ~3 GB RAM) - Standard lokal.
# voyage: Voyage-AI-API (voyage-4, kein Modell im Container) - fuer Railway. Wechsel => neu indexieren.
# openai: text-embedding-3-small/-large ueber OPENAI_API_KEY, Vektorlaenge = EMBEDDING_DIM. Wechsel => neu indexieren.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Nur CI/Eval: Ordner, in dem Dokument-Vektoren je Abschnittstext wiederverwendet werden. Leer = aus (Betrieb).
EMBEDDING_CACHE_DIR=

# --- Ablage und Gespraechsverlauf ---
# DATA_DIR: Uploads, Bilder, Flow-Cache (Railway: Volume auf /data). CHECKPOINTER: sqlite | postgres.
DATA_DIR=
CHECKPOINTER=sqlite

# --- Ingestion ---
# Texterkennung fuer Scans, lokal auf der CPU (RapidOCR, ohne Download und ohne API-Kosten):
# auto = nur Seiten ohne Textebene (EPLAN-Exporte enthalten echten Text), always = jede Seite, off = keine.
OCR_MODE=auto
# Alter Schalter: true heisst OCR_MODE=always.
OCR_ENABLED=false
# Laengste Bildkante in Pixeln fuer die Vision-Analyse von Schaltplanseiten.
VISION_MAX_EDGE=2400
# Beim Start unterbrochene Dokumente aller Workspaces weiterverarbeiten. Nur fuer den einen Backend-Prozess;
# pytest schaltet es ab (backend/tests/conftest.py), weil Tests lokal dieselbe Datenbank nutzen.
RESUME_INGESTION=true

# --- Ablauf-Visualisierung (extract-flow) ---
# Kleines Modell fuer I/O-Liste und Sensor/Aktor (parallel), starkes nur fuer die Schrittkette.
FLOW_MODEL_SMALL=claude-haiku-4-5
FLOW_MODEL_STRONG=claude-opus-5
FLOW_EFFORT=medium
# Langfuse (optional, pip install -e "backend[trace]"): ohne Schluessel kein Trace, alles laeuft trotzdem.
# Getrackt werden Chat, die Vision-Aufrufe und die Ablauf-Extraktion (siehe README "Tracing").
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Planleser per Modell (optional) ---
# Leer = aus: der Signalweg liest Leitungen nur mit Regeln, keine Seite verlaesst den Rechner. Gesetzt, etwa
# openai:gpt-5-mini, liest das Modell die Planseiten erst auf Knopfdruck, mit Kostenschaetzung davor.
PLAN_READER_MODEL=
# Leer = Anbieter. Fuer einen OpenAI-kompatiblen lokalen Endpunkt etwa http://localhost:11434/v1 (Ollama),
# dann ohne Kosten und ohne Schluessel des Anbieters.
PLAN_READER_BASE_URL=
# Lokale Modelle: Modellname "ollama:qwen3.5:4b" (CHAT_MODEL, PLAN_READER_MODEL, eval --model) spricht Ollamas
# OpenAI-Endpunkt an, ohne Schluessel. Ollama selbst braucht OLLAMA_CONTEXT_LENGTH=32768 (Standard sind 4k).
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Zugriff ---
# Gemeinsamer Schluessel fuer alle /api-Routen (leer = offen, nur lokal). Frontend, Skripte und
# MCP-Server schicken ihn als X-API-Key; Bild-URLs als ?api_key=. Erzeugen: python -c "import secrets;print(secrets.token_urlsafe(32))"
API_KEY=
NEXT_PUBLIC_API_KEY=
STROMLAUF_API_KEY=

# --- Anmeldung per Magic-Link (Mandanten) ---
# JWT_SECRET gesetzt = Login aktiv (python -c "import secrets;print(secrets.token_urlsafe(48))").
# Ohne SMTP_URL landet der Link im Log; AUTH_DEV_LINK=true zeigt ihn zusaetzlich in der Antwort (nur Entwicklung).
JWT_SECRET=
JWT_TTL_HOURS=12
AUTH_DEV_LINK=false
SMTP_URL=
MAIL_FROM=stromlauf@localhost
FRONTEND_URL=http://localhost:3100

# --- Frontend ---
CORS_ORIGINS=http://localhost:3100
NEXT_PUBLIC_API_URL=http://localhost:8010
